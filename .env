CORS_ORIGINS=http://localhost:3000,http://localhost:3090,http://localhost:5173
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
MIN_CONFIDENCE=0.6
LOG_TEXT=false

# Translator: "tower" or "nllb"
# Note: Tower has generation issues with current setup, using NLLB
TRANSLATOR_TYPE=nllb

# Tower settings (medical-optimized, used when TRANSLATOR_TYPE=tower)
# Use 2B for faster loading, change to "auto" for 9B (better quality, slower)
TOWER_MODEL_NAME=Unbabel/Tower-Plus-2B
TOWER_FALLBACK_MODEL=Unbabel/Tower-Plus-2B
TOWER_DEVICE=auto
TOWER_MAX_LENGTH=2048
TOWER_LOAD_IN_4BIT=true
TOWER_USE_FLASH_ATTENTION=true

# NLLB settings (used when TRANSLATOR_TYPE=nllb)
NLLB_MODEL_NAME=facebook/nllb-200-1.3B
NLLB_DEVICE=cuda
NLLB_MAX_LENGTH=1024

ENABLE_SPAN_BACKTRANSLATION=true
NORMALIZATION_RULES_PATH=/app/data/normalization/es_ar.yml
HPO_OBO_PATH=/app/data/hpo/hp.obo
HPO_INDEX_PATH=/app/data/hpo/hpo_index.json
HPO_ES_PATH=/app/data/hpo/hp-es.json
HPO_DOWNLOAD_URL=https://raw.githubusercontent.com/obophenotype/human-phenotype-ontology/master/hp.obo
REDIS_URL=redis://redis:6379/0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
WEB_PORT=3090
AUDIT_DB_USER=diagnostic_audit
AUDIT_DB_PASSWORD=diagnostic_audit
AUDIT_DB_NAME=diagnostic_audit
AUDIT_DATABASE_URL=postgresql://diagnostic_audit:diagnostic_audit@audit-db:5432/diagnostic_audit
STORE_REQUESTS=true
