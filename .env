CORS_ORIGINS=http://localhost:3090,http://localhost:5173
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
MIN_CONFIDENCE=0.6
LOG_TEXT=false
NLLB_MODEL_NAME=facebook/nllb-200-1.3B
NLLB_DEVICE=cuda
NLLB_MAX_LENGTH=512
ENABLE_SPAN_BACKTRANSLATION=true
NORMALIZATION_RULES_PATH=/app/data/normalization/es_ar.yml
HPO_OBO_PATH=/app/data/hpo/hp.obo
HPO_INDEX_PATH=/app/data/hpo/hpo_index.json
HPO_DOWNLOAD_URL=https://raw.githubusercontent.com/obophenotype/human-phenotype-ontology/master/hp.obo
REDIS_URL=redis://redis:6379/0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
WEB_PORT=3090
