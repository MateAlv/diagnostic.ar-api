# =============================================================================
# diagnostic.ar-api — nodo brainy (GPU node)
# Copy to .env and fill in all values marked CHANGE_ME
# =============================================================================

# ── Public origin allowed by CORS (nodo0 Traefik host) ───────────────────────
CORS_ORIGINS=https://diagnosticar.infa.cluster.qb.fcen.uba.ar

# ── Host binding on brainy (keep localhost-only for reverse SSH tunnel) ─────
API_BIND_IP=127.0.0.1
API_PORT=8000
GENPHENAI_BIND_IP=127.0.0.1
GENPHENAI_PORT=18020
GENPHENIA_INFERENCE_URL=http://host.docker.internal:8002/predict
GENPHENIA_INFERENCE_TIMEOUT_SECONDS=30
GENPHENIA_POSTPROCESS_TOP_K=200
GENPHENIA_INFERENCE_MAX_TOP_K=5229

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ── HPO API ───────────────────────────────────────────────────────────────────
MIN_CONFIDENCE=0.6
LOG_TEXT=false
STORE_REQUESTS=true
ENABLE_SPANISH_HPO_MATCHING=true

# ── Symptom extraction (Ollama LLM on same machine) ──────────────────────────
ENABLE_SYMPTOM_EXTRACTION=true
OLLAMA_URL=http://llm-ollama:11434
SYMPTOM_EXTRACTOR_MODEL=qwen2.5:7b

# ── NLLB translation (GPU) ────────────────────────────────────────────────────
NLLB_MODEL_NAME=facebook/nllb-200-1.3B
NLLB_DEVICE=cuda
NLLB_MAX_LENGTH=512

# ── NVIDIA ────────────────────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ── Data paths (inside container) ────────────────────────────────────────────
NORMALIZATION_RULES_PATH=/app/data/normalization/es_ar.yml
HPO_OBO_PATH=/app/data/hpo/hp.obo
HPO_INDEX_PATH=/app/data/hpo/hpo_index.json
HPO_ES_PATH=/app/data/hpo/hp-es.json
HPO_DOWNLOAD_URL=https://raw.githubusercontent.com/obophenotype/human-phenotype-ontology/master/hp.obo

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Audit database ────────────────────────────────────────────────────────────
AUDIT_DB_USER=diagnostic_audit
AUDIT_DB_PASSWORD=CHANGE_ME_strong_password
AUDIT_DB_NAME=diagnostic_audit
AUDIT_DATABASE_URL=postgresql://diagnostic_audit:CHANGE_ME_strong_password@audit-db:5432/diagnostic_audit
