CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
MIN_CONFIDENCE=0.6
LOG_TEXT=false
NLLB_MODEL_NAME=auto
NLLB_DEVICE=auto
NLLB_MAX_LENGTH=512
ENABLE_SPAN_BACKTRANSLATION=true
NORMALIZATION_RULES_PATH=/app/data/normalization/es_ar.yml
HPO_OBO_PATH=/app/data/hpo/hp.obo
HPO_INDEX_PATH=/app/data/hpo/hpo_index.json
HPO_DOWNLOAD_URL=https://raw.githubusercontent.com/obophenotype/human-phenotype-ontology/master/hp.obo
WEB_PORT=3000
