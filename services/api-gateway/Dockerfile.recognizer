# syntax=docker/dockerfile:1.7
#
# The gateway with /extract-hpo served by the Spanish symptom recognizer.
#
# CPU only. The recognizer's LLM is remote and its encoder is small enough for
# a CPU, so this runs on a node with no GPU. The incumbent's Ollama and NLLB
# paths are still installed, because search and the health checks are served
# by the incumbent pipeline, but nothing here calls them for extraction.
#
# The recognizer is not on PyPI, so its code comes in as a second build
# context (MateAlv/spanish-symptoms-recognizer):
#
#   docker buildx build -f services/api-gateway/Dockerfile.recognizer \
#     --build-context recognizer=../spanish-symptoms-recognizer \
#     -t diagnosticar-hpo-recognizer:dev .
#
# Its model assets are not in git. The ClinLinker encoder is fetched here at
# the revision pinned in embeddings.lock, and the HPO embeddings come ready
# made: a release of MateAlv/diagnostic.ar-model, generated once from that same
# encoder, labels and script. Fetch it first, as for the model:
#
#   services/api-gateway/fetch_embeddings.sh      # -> embeddings-dist/
#
# The build refuses a package that does not match the sha256 its release
# publishes, or whose manifest names another encoder, other labels or another
# generator script than this build uses: a new encoder means new embeddings,
# never a mismatch.
# Whatever assets the checkout happens to hold are discarded.

# 3.12: the recognizer pins numpy 2.5, which has no 3.11 wheels; TARS runs 3.12.3.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# The upgrade because the published base image lags on Debian security fixes.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# The version measured on TARS; the provider shells out to it. npm is only
# needed to install it, and the npm that ships with Node carries HIGH
# advisories the release scan rejects, so it leaves the image in this layer.
# Without npm the CLI cannot update itself, which is what a pinned version wants.
RUN npm install -g @anthropic-ai/claude-code@2.1.270 && npm cache clean --force \
    && rm -rf /usr/lib/node_modules/npm /usr/lib/node_modules/corepack \
              /usr/bin/npm /usr/bin/npx /usr/bin/corepack /root/.npm
ENV DISABLE_AUTOUPDATER=1

# CPU wheels first, so nothing below pulls the CUDA build back in.
RUN pip install torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu

# The recognizer's pins win where the two overlap (pydantic, spacy, httpx,
# transformers): it is the side that cannot be loosened without re-measuring.
# Dropped: the CUDA/NVIDIA wheels, and medspacy with its compiled helpers,
# which only the offline NER training path imports.
COPY --from=recognizer requirements.txt /tmp/recognizer-requirements.txt
RUN grep -v -E '^(torch|triton|nvidia-|cuda-|medspacy|PyFastNER|PyRuSH|quicksectx|pysimstring)' \
        /tmp/recognizer-requirements.txt > /tmp/recognizer-runtime.txt \
    && pip install -r /tmp/recognizer-runtime.txt

# Newer than requirements.txt on purpose: the release scan fails on PyJWT
# 2.10 (CVE-2026-48526, forged-token authentication bypass, in the library
# that verifies every session here), on Starlette 0.37, and on the
# recognizer's urllib3 2.7.0 (CVE-2026-97687, CVE-2026-97689). Since
# 2026-10-28 also on its aiohttp 3.14.3 (CVE-2026-111064, CVE-2026-111066,
# GHSA-2g87-pp6c-29x5), certifi 2026.7.22 (GHSA-6q48-6c7w-9gw2, compromised
# emSign CAs), filelock 3.32.3 (CVE-2026-112940) and nltk 3.10.3
# (GHSA-j456-xh4h-cpf2). Since 2026-11-06 also on pyasn1 0.6.4
# (CVE-2026-119194 to CVE-2026-119197), which only
# google-auth pulls in.
RUN pip install \
        fastapi==0.141.1 \
        pyasn1==0.6.5 \
        urllib3==2.8.0 \
        aiohttp==3.14.4 \
        certifi==2026.10.18 \
        filelock==4.2.1 \
        nltk==3.10.4 \
        "uvicorn[standard]==0.54.0" \
        pydantic-settings \
        redis==5.0.7 \
        rapidfuzz==3.9.6 \
        "psycopg[binary]==3.2.3" \
        "PyJWT[crypto]==2.15.0" \
        https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl

# The ClinLinker encoder, at the revision the recognizer was evaluated with on
# 2026-09-21 (embeddings.lock): the extractor encodes what people write with
# it. Fetched before the code is copied, so a code change does not download
# 485 MB again.
RUN --mount=type=bind,source=services/api-gateway/embeddings.lock,target=/tmp/embeddings.lock \
    . /tmp/embeddings.lock \
    && python -c "from huggingface_hub import snapshot_download; snapshot_download('${CLINLINKER_REPO}', revision='${CLINLINKER_REVISION}', local_dir='/opt/assets/clinlinker-kb-gp', allow_patterns=['*.json', '*.txt', 'pytorch_model.bin'])" \
    && rm -rf /opt/assets/clinlinker-kb-gp/.cache

RUN useradd --create-home --uid 10001 app \
    && mkdir -p /var/lib/recognizer && chown app /var/lib/recognizer
# Where EXTRACTION_BUDGET_STATE lives when a volume is mounted here. Created
# owned by `app` so a new named volume inherits that owner instead of root.
WORKDIR /app

COPY --from=recognizer --chown=app symptoms_recognizer /opt/recognizer/symptoms_recognizer
# The embeddings and the labels they were made from, unpacked from the pinned
# release (fetch_embeddings.sh) after checking the sha256 it publishes, and its
# manifest against this build (check_embeddings.py). The manifest stays in the image,
# at /opt/recognizer/hpo-embeddings-manifest.json, as the record of what runs.
RUN --mount=type=bind,source=services/api-gateway/embeddings.lock,target=/tmp/embeddings.lock \
    --mount=type=bind,source=services/api-gateway/check_embeddings.py,target=/tmp/check_embeddings.py \
    --mount=type=bind,source=embeddings-dist,target=/tmp/embeddings-dist \
    . /tmp/embeddings.lock \
    && (cd /tmp/embeddings-dist && sha256sum -c --quiet "$EMB_ASSET.sha256") \
    && mkdir /tmp/package && tar -xzf "/tmp/embeddings-dist/$EMB_ASSET" -C /tmp/package \
    && cd /opt/recognizer/symptoms_recognizer/mapper \
    && python /tmp/check_embeddings.py /tmp/package /tmp/embeddings.lock hpo_tsv_reader.py \
    && rm -rf semantic_model/clinlinker-kb-gp hpo/hpo_batches hpo/hp-es.babelon.tsv \
    && mkdir -p semantic_model hpo \
    && cp -r /opt/assets/clinlinker-kb-gp semantic_model/clinlinker-kb-gp \
    && cp -r /tmp/package/hpo/. hpo/ \
    && cp /tmp/package/manifest.json /opt/recognizer/hpo-embeddings-manifest.json \
    && rm -rf /tmp/package /opt/assets \
    && chown -R app /opt/recognizer
COPY --chown=app services /app/services
COPY --chown=app services/api-gateway/app /app/app
COPY --chown=app data /app/data
COPY --chown=app scripts /app/scripts

ENV PYTHONPATH=/app:/opt/recognizer \
    HOME=/home/app \
    USE_RECOGNIZER=true \
    RECOGNIZER_PROVIDER=claude-cli

USER app
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
